{
  "name": "deepseek-harness-for-codex",
  "version": "0.3.1",
  "description": "Codex plugin for delegating work to visible local DeepSeek Harness sessions and independently reviewing the results.",
  "type": "module",
  "bin": {
    "deepseek-harness-for-codex": "dist/bin.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "README.en.md",
    "imgs/",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seann0824/deepseek-harness-for-codex.git"
  },
  "homepage": "https://github.com/Seann0824/deepseek-harness-for-codex#readme",
  "bugs": {
    "url": "https://github.com/Seann0824/deepseek-harness-for-codex/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "release:check": "npm run check && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "codex",
    "deepseek",
    "mcp",
    "model-context-protocol",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
