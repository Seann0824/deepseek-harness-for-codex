{
  "mcpServers": {
    "deepseek-harness": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=deepseek-harness-mcp@0.2.3",
        "--",
        "deepseek-harness-mcp"
      ],
      "env_vars": [
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DSH_MCP_DATA_DIR",
        "DSH_MCP_HARNESS_PACKAGE",
        "DSH_MCP_NPX_COMMAND",
        "DSH_MCP_WORKSPACE_ROOTS",
        "DSH_PERMISSION_MODE"
      ]
    }
  }
}
